# ==============================================================================
# ServiceAI - Environment Configuration Template
# ==============================================================================

# Server & Discovery Port
SERVER_PORT=8086
EUREKA_URI=http://discovery-server:8761/eureka/
CONFIG_SERVER_URL=http://config-server:8888

# Google Gemini API Configuration
# Get your free key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Mock Mode (Set to true to use structured simulation when offline or testing)
GEMINI_MOCK_MODE=false

# Database Configuration (Shared internhub_db)
DB_HOST=mysql-db
DB_PORT=3306
DB_NAME=internhub_db
DB_USERNAME=root
DB_PASSWORD=123456

# Microservice Internal URLs
INTERN_SERVICE_URL=http://intern-and-program-service:8082
FILE_SERVICE_URL=http://file-service:8084
