# ==============================================================================
# InternHub - Environment Configuration Guide (Email & Integration Module)
# ==============================================================================
# Hướng dẫn cấu hình biến môi trường cho hệ thống gửi email (TM-12)
# Khuyến cáo: KHÔNG commit thông tin mật khẩu thật lên Git repository.
# ==============================================================================

# 1. Cấu hình Mail Server (SMTP)
# Mặc định hỗ trợ Gmail SMTP, SendGrid, Amazon SES hoặc Mailtrap
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply.internhub@gmail.com
MAIL_PASSWORD=your_app_password_here

# 2. Chế độ Mock Testing
# - true: Ghi log nội dung email ra Console, không kết nối SMTP thật (mặc định khi test local)
# - false: Kết nối và gửi email thật qua SMTP server
MAIL_MOCK_MODE=true

# 3. Thông tin hiển thị thương hiệu trong Email
COMPANY_NAME=InternHub Technology
SUPPORT_EMAIL=support@internhub.com

# 4. Địa chỉ URL Frontend (Phục vụ nút CTA Xem thông tin onboarding)
# - Local dev: http://localhost:5173
# - Staging:   https://staging.internhub.vn
# - Production: https://app.internhub.vn
APP_FRONTEND_URL=http://localhost:5173

# 5. Địa chỉ kết nối nội bộ giữa các Microservice
INTERN_SERVICE_URL=http://intern-and-program-service:8082
REPORTING_SERVICE_URL=http://reporting-and-integration-service:8083
